# Copy to .env.production on the Lightsail server, never commit the actual values.
# Use the actual domain when DNS is ready, e.g. kandyads.lk.
DOMAIN=kandyads.lk

# Generate separately: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=CHANGE_TO_RANDOM_HEX
MYSQL_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_HEX
JWT_SECRET=CHANGE_TO_RANDOM_HEX
